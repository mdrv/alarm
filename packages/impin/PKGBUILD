# Maintainer: Umar Alfarouk <medrivia@gmail.com>
pkgname=impin
pkgver=0.2.0
pkgrel=1
pkgdesc="Wayland layer-shell overlay pinning reference images above your canvas: drag, zoom, pan, opacity"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/impin"
license=('MIT')
depends=('wayland' 'libxkbcommon' 'fontconfig')
provides=("impin")
conflicts=("impin")
source_x86_64=("${pkgname}-${pkgver}-x86_64-unknown-linux-gnu.tar.gz::https://github.com/mdrv/${pkgname}/releases/download/v${pkgver}/${pkgname}-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64-unknown-linux-gnu.tar.gz::https://github.com/mdrv/${pkgname}/releases/download/v${pkgver}/${pkgname}-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('c117a253c135c0b4ec60669d65044077cccaf840f6834e98db93a296ddc6f8fe')
sha256sums_aarch64=('458576417019bc1135e384860327d236555ecfebef0416ea58cb308106de9373')

# Prebuilt release binaries — no compilation here (upstream builds in the
# release workflow on Arch containers).
package() {
	cd "${srcdir}/${pkgname}"
	install -Dm755 "${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
	install -Dm644 "impin.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
	install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
