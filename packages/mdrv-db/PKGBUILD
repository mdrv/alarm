# Maintainer: Umar Alfarouk <medrivia@gmail.com>

_pkgname=mdrv-db
pkgname=mdrv-db
pkgver=0.6.3
pkgrel=2
pkgdesc="Fjall durability envelope around a SQL data port and content-addressed blob store (fleet CLI)"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/mdrv-db"
license=('MIT')
depends=()
options=('!debug')
source_x86_64=("$_pkgname-$pkgver-x86_64-musl.tar.gz::https://github.com/mdrv/$_pkgname/releases/download/v$pkgver/$_pkgname-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64-musl.tar.gz::https://github.com/mdrv/$_pkgname/releases/download/v$pkgver/$_pkgname-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('1f7f0417b61e2bbff3fd7ec390912ec6d73801290c50afd76e146c0c21c1683a')
sha256sums_aarch64=('02df0dd103f85af5772c4b06f823f5db0cd9dd92641da3f4856620cb9ee3acfa')

package() {
  cd "$srcdir"/$_pkgname-v$pkgver-*-musl

  # Fully static musl binary
  install -Dm755 mdrv-db "$pkgdir/usr/bin/mdrv-db"

  # Carapace completion spec (shipped in the tarball, matches `mdrv-db completion`)
  install -Dm644 mdrv-db.yaml "$pkgdir/usr/share/carapace/specs/mdrv-db.yaml"

  # License
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
