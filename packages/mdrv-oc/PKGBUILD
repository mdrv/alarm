# Maintainer: Umar Alfarouk <medrivia@gmail.com>

pkgname=mdrv-oc
pkgver=0.1.1
pkgrel=1
pkgdesc="OpenCode session database manager (list, move, export/import, inspect sessions)"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/mdrv-oc"
license=('MIT')
options=('!debug' '!lto')
# Upstream releases are fully static musl builds: readelf -d shows no
# NEEDED entries, so there is nothing to depend on.
source=("mdrv-oc-LICENSE::https://raw.githubusercontent.com/mdrv/mdrv-oc/main/LICENSE")
sha256sums=('eed271e5501e1ff8db061905825be86dceb17027004fccf29b2d46820b3e8423')
source_x86_64=("$pkgname-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/mdrv-oc-$pkgver-linux-x86_64.tar.gz")
sha256sums_x86_64=('bba65de70d6797a164b93a91fcb471b048e023b7369ca17096a0f830a7120c9d')
source_aarch64=("$pkgname-$pkgver-linux-aarch64.tar.gz::$url/releases/download/v$pkgver/mdrv-oc-$pkgver-linux-aarch64.tar.gz")
sha256sums_aarch64=('83884c151c64a933533b8b7fe250b50168f98bfa457eb121cb3d53064dbd667b')

package() {
  cd "$pkgname"
  install -Dm755 mdrv-oc "$pkgdir/usr/bin/mdrv-oc"
  install -Dm644 mdrv-oc.yaml "$pkgdir/usr/share/carapace/specs/mdrv-oc.yaml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/mdrv-oc-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

post_install() {
  echo "==> carapace-bin loads user specs ONLY from ~/.config/carapace/specs"
  echo "==> Enable completions:  mdrv-oc completion > ~/.config/carapace/specs/mdrv-oc.yaml"
}
