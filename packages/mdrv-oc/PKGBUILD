# Maintainer: Umar Alfarouk <medrivia@gmail.com>

pkgname=mdrv-oc
pkgver=0.2.0
pkgrel=1
pkgdesc="OpenCode session database manager (list, move, export/import/sync, inspect sessions)"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/mdrv-oc"
license=('MIT')
options=('!debug' '!lto')
# Upstream releases are fully static musl builds: readelf -d shows no
# NEEDED entries, so there is nothing to depend on.
source=("mdrv-oc-LICENSE::https://raw.githubusercontent.com/mdrv/mdrv-oc/main/LICENSE")
sha256sums=('eed271e5501e1ff8db061905825be86dceb17027004fccf29b2d46820b3e8423')
# Upstream asset names embed the full tag (including the leading v):
# mdrv-oc-v0.2.0-<rust-target>.tar.gz
source_x86_64=("$pkgname-$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/mdrv-oc-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('fdda04bfeb1a1c2f94bac83cd10217c6056433a83693641f08b8e79d495b502d')
source_aarch64=("$pkgname-$pkgver-linux-aarch64.tar.gz::$url/releases/download/v$pkgver/mdrv-oc-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_aarch64=('75ef58d14e0d02c179f784625046365577ee462b61d1daad99db6548c231004e')

package() {
  cd "$pkgname"
  install -Dm755 mdrv-oc "$pkgdir/usr/bin/mdrv-oc"
  install -Dm644 mdrv-oc.yaml "$pkgdir/usr/share/carapace/specs/mdrv-oc.yaml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/mdrv-oc-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

post_install() {
  echo "==> carapace-bin loads user specs ONLY from ~/.config/carapace/specs"
  echo "==> Enable completions:  mdrv-oc completion > ~/.config/carapace/specs/mdrv-oc.yaml"
}
