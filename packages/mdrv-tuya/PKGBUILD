# Maintainer (aarch64): Umar Alfarouk <medrivia@gmail.com>
# Maintainer (x86_64): Umar Alfarouk <medrivia@gmail.com>
pkgname=mdrv-tuya
pkgver=0.0.4
pkgrel=1
pkgdesc="Self-hosted BLE daemon + live web UI for Tuya smart lamps (in-lite INSM044), no cloud"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/mdrv-tuya"
license=('MIT')
depends=('bluez' 'dbus' 'libgcc')
options=(!debug)
source_x86_64=("$url/releases/download/v$pkgver/mdrv-tuya-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('6ebf9213d924b24bc0aa3d5fa7de05dc8543e73df49ae03ced7bf0a53b548ee5')
source_aarch64=("$url/releases/download/v$pkgver/mdrv-tuya-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_aarch64=('f90a7528a0c9267fb3101ac5ab6e482f6a6205115949a887df2b712fe57e7f94')

# gnu binaries (bluer links libdbus, so musl-static is not practical)
package() {
	cd "${srcdir}/mdrv-tuya-v$pkgver-$CARCH-unknown-linux-gnu"
	install -Dm755 mdrv-tuya "${pkgdir}/usr/bin/mdrv-tuya"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
