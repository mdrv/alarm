# Maintainer: Umar Alfarouk <medrivia@gmail.com>

pkgname=opencode
pkgver=2.2.6
pkgrel=1
pkgdesc="The open source coding agent"
arch=('x86_64' 'aarch64')
url="https://github.com/anomalyco/opencode"
license=('MIT')
depends=('git' 'ripgrep' 'tar')
makedepends=('bun')
optdepends=('wl-clipboard: clipboard support on Wayland'
            'xclip: clipboard support on X11')
provides=('opencode')
conflicts=('opencode')
options=('!debug' '!strip')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('bd9422a4384565a847345a1e85750964c1b8b3dcfe4db3baab500f9de132e3c5')

prepare() {
	cd "$pkgname"
	# bun fetches git deps (ghostty-web) through api.github.com, which
	# intermittently 5xxes from CI runners; the x86_64 job failing while
	# aarch64 succeeds on the same lockfile proves it is transient, so
	# retry before giving up (successful downloads stay in bun's cache)
	local attempt
	for attempt in 1 2 3; do
		if bun install --frozen-lockfile --ignore-scripts; then
			return
		fi
		echo "bun install attempt $attempt failed; retrying in $((attempt * 15))s" >&2
		sleep $((attempt * 15))
	done
	return 1
}

build() {
	cd "$pkgname/packages/cli"
	OPENCODE_VERSION=$pkgver bun run ./script/build.ts --single --baseline --skip-install
}

package() {
	cd "$pkgname"
	case $CARCH in
	aarch64) dir=cli-linux-arm64 ;;
	x86_64) dir=cli-linux-x64-baseline ;;
	esac

	install -Dm755 "packages/cli/dist/$dir/bin/opencode" "$pkgdir/usr/bin/opencode"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

	"$pkgdir/usr/bin/opencode" --completions bash \
		| install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/opencode"
	"$pkgdir/usr/bin/opencode" --completions zsh \
		| install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
}
