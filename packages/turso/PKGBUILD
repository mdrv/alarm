# Maintainer: Umar Alfarouk <medrivia@gmail.com>
# Based on turso-bin from AUR by aarto <aarto@aur.archlinux.org>

pkgname=turso
pkgver=0.8.2
pkgrel=1
pkgdesc="In-process SQL database engine compatible with SQLite"
arch=('x86_64' 'aarch64')
url="https://github.com/tursodatabase/turso"
license=('MIT')
depends=('libgcc')
conflicts=('turso-bin')
options=('!debug')
source_x86_64=("$pkgname-x86_64-$pkgver.tar.xz::$url/releases/download/v$pkgver/turso_cli-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("$pkgname-aarch64-$pkgver.tar.xz::$url/releases/download/v$pkgver/turso_cli-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('1a12393fdb1fc36ef4c0339609b2652d6a0f7bb4a5f6c08da4afe1d364422d18')
sha256sums_aarch64=('9c88e352173d913a8202637f22030d1521d0f6085e34c39961b2bc2745837d9f')

package() {
  cd "$srcdir/turso_cli-$CARCH-unknown-linux-gnu"
  install -Dm755 tursodb "$pkgdir/usr/bin/tursodb"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
