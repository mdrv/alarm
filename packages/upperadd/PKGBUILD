# Maintainer: Umar Alfarouk <medrivia@gmail.com>
pkgname=upperadd
pkgver=0.1.1
pkgrel=1
pkgdesc="Wayland layer-shell overlay to jump into markdown notes: fuzzy search, live preview, editor handoff"
arch=('x86_64' 'aarch64')
url="https://github.com/mdrv/upperadd"
license=('MIT')
depends=('wayland' 'libxkbcommon' 'fontconfig')
provides=("upperadd")
conflicts=("upperadd")
source_x86_64=("${pkgname}-${pkgver}-x86_64-unknown-linux-gnu.tar.gz::https://github.com/mdrv/${pkgname}/releases/download/v${pkgver}/${pkgname}-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64-unknown-linux-gnu.tar.gz::https://github.com/mdrv/${pkgname}/releases/download/v${pkgver}/${pkgname}-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('e875c62e84792c98bed16e5114c825ea9083964afe0d28daf39c8580c65d61b5')
sha256sums_aarch64=('07b8aafd5a18cc8ec673416fa2d62727d744f88912242648ff3f768265c23411')

# Prebuilt release binaries — no compilation here (upstream builds in the
# release workflow on Arch containers).
package() {
	cd "${srcdir}/${pkgname}"
	install -Dm755 "${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
	ln -s "${pkgname}" "${pkgdir}/usr/bin/ua"
	install -Dm644 "${pkgname}.service" "${pkgdir}/usr/lib/systemd/user/${pkgname}.service"
	install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
